        }
      ],
      "unevaluatedProperties": false
    },
    "evaluation_run_manifest": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "properties": {
            "record_type": { "const": "evaluation_run_manifest" },
